<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Catalog - Cinnabon PK</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Enriqueta:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Enriqueta:wght@400;500;600;700&family=Urbanist:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .catalog-container {
            max-width: 1200px;
            margin: 100px auto 40px;
            padding: 20px;
        }
        
        .filters-section {
            background: #f8f8f8;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
        }
        
        .filters-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 15px;
        }
        
        .filter-group label {
            font-family: 'Enriqueta', serif;
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #071D49;
        }
        
        .filter-group input,
        .filter-group select {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 14px;
        }
        
        .filter-btn {
            background: #071D49;
            color: white;
            padding: 10px 25px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14px;
        }
        
        .filter-btn:hover {
            background: #0a2d6e;
        }
        
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .product-card {
            background: white;
            border: 1px solid #e8e8e8;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            transition: transform 0.3s;
        }
        
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .product-card img {
            width: 100%;
            height: 200px;
            object-fit: contain;
            margin-bottom: 15px;
        }
        
        .product-card h3 {
            font-size: 1.1rem;
            color: #071D49;
            margin: 10px 0;
        }
        
        .product-card .price {
            font-family: 'Enriqueta', serif;
            font-size: 1.2rem;
            color: #E91E8C;
            font-weight: 700;
            margin: 10px 0;
        }
        
        .product-card .category {
            font-family: 'Urbanist', sans-serif;
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 5px;
        }
        
        .product-card .rating {
            color: #f39c12;
            margin-bottom: 10px;
        }
        
        .product-card .stock {
            font-size: 0.85rem;
            color: #27ae60;
        }
        
        .product-card .stock.low {
            color: #e74c3c;
        }
        
        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-top: 30px;
        }
        
        .pagination a,
        .pagination span {
            padding: 8px 15px;
            border: 1px solid #071D49;
            border-radius: 5px;
            text-decoration: none;
            color: #071D49;
        }
        
        .pagination a:hover {
            background: #071D49;
            color: white;
        }
        
        .pagination .current {
            background: #071D49;
            color: white;
        }
        
        .pagination .disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .results-info {
            text-align: center;
            margin-bottom: 20px;
            color: #666;
        }
    </style>
</head>
<body>
    <header class="navbar">
        <div class="logo-box">
            <img src="/images/logo.png" alt="Cinnabon Logo" class="logo">
        </div>
        <button class="hamburger-menu" id="hamburgerMenu">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
        <nav class="nav-links" id="navLinks">
            <a href="/">Home</a>
            <a href="/products">Products</a>
            <a href="#">Contact Us</a>
            <a href="/admin" style="font-weight:bold;color:#071D49;">Admin Panel</a>
            <% if (currentUser.isLoggedIn) { %>
                <span style="font-family:'Urbanist',sans-serif;font-size:14px;color:#071D49;">Hi, <%= currentUser.name.split(' ')[0] %></span>
                <form action="/auth/logout" method="POST" style="display:inline;">
                    <button type="submit" style="background:none;border:none;cursor:pointer;font-family:'Urbanist',sans-serif;font-size:14px;color:#071D49;padding:0;">Logout</button>
                </form>
            <% } else { %>
                <a href="/auth/login">Login</a>
                <a href="/auth/register">Register</a>
            <% } %>
            <a class="order-btn" href="#">Start Order</a>
        </nav>
    </header>
    
    <div class="catalog-container">
        <h1 style="text-align: center; margin-bottom: 30px; color: #071D49;">Our Product Catalog</h1>
        
        <div class="filters-section">
            <form method="GET" action="/products">
                <div class="filters-grid">
                    <div class="filter-group">
                        <label for="search">Search Products:</label>
                        <input type="text" id="search" name="search" placeholder="Search by name..." value="<%= search %>">
                    </div>
                    
                    <div class="filter-group">
                        <label for="category">Category:</label>
                        <select id="category" name="category">
                            <option value="">All Categories</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>><%= cat %></option>
                            <% }) %>
                        </select>
                    </div>
                    
                    <div class="filter-group">
                        <label for="minPrice">Min Price ($):</label>
                        <input type="number" id="minPrice" name="minPrice" placeholder="0" value="<%= minPrice %>" min="0" step="0.01">
                    </div>
                    
                    <div class="filter-group">
                        <label for="maxPrice">Max Price ($):</label>
                        <input type="number" id="maxPrice" name="maxPrice" placeholder="1000" value="<%= maxPrice %>" min="0" step="0.01">
                    </div>
                </div>
                
                <div style="text-align: center;">
                    <button type="submit" class="filter-btn">Apply Filters</button>
                </div>
            </form>
        </div>
        
        <div class="results-info">
            Showing <%= products.length %> of <%= totalProducts %> products (Page <%= currentPage %> of <%= totalPages %>)
        </div>
        
        <div class="products-grid">
            <% if (products.length > 0) { %>
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <img src="<%= product.image %>" alt="<%= product.name %>">
                        <div class="category"><%= product.category %></div>
                        <h3><%= product.name %></h3>
                        <div class="rating">Star <%= product.rating %>/5</div>
                        <div class="price">$<%= product.price.toFixed(2) %></div>
                        <div class="stock <%= product.stock < 20 ? 'low' : '' %>">
                            <%= product.stock < 20 ? 'Low Stock' : 'In Stock' %> (<%= product.stock %>)
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="grid-column: 1/-1; text-align: center; color: #666;">No products found matching your criteria.</p>
            <% } %>
        </div>
        
        <% if (totalPages > 1) { %>
            <div class="pagination">
                <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">Previous</a>
                <% } else { %>
                    <span class="disabled">Previous</span>
                <% } %>
                
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="current"><%= i %></span>
                    <% } else { %>
                        <a href="?page=<%= i %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>"><%= i %></a>
                    <% } %>
                <% } %>
                
                <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>">Next</a>
                <% } else { %>
                    <span class="disabled">Next</span>
                <% } %>
            </div>
        <% } %>
    </div>
    
    <script src="/js/script.js"></script>
</body>
</html>