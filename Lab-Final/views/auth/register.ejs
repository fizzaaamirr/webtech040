<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Cinnabon PK</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Enriqueta:wght@400;500;600;700&family=Urbanist:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { background: #f8f8f8; }
        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 20px 40px;
        }
        .auth-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 30px rgba(0,0,0,0.1);
            padding: 48px 40px;
            width: 100%;
            max-width: 440px;
        }
        .auth-logo { text-align: center; margin-bottom: 10px; }
        .auth-logo img { height: 52px; }
        .auth-title {
            font-family: 'Enriqueta', serif;
            font-size: 26px;
            color: #071D49;
            text-align: center;
            margin-bottom: 6px;
        }
        .auth-subtitle {
            font-family: 'Urbanist', sans-serif;
            color: #888;
            text-align: center;
            margin-bottom: 28px;
            font-size: 14px;
        }
        .flash-msg {
            border-radius: 8px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-family: 'Urbanist', sans-serif;
            font-size: 14px;
        }
        .flash-error { background: #fdecea; color: #c0392b; border-left: 4px solid #e74c3c; }
        .flash-success { background: #eafaf1; color: #1e8449; border-left: 4px solid #2ecc71; }
        .form-group { margin-bottom: 20px; }
        .form-group label {
            display: block;
            font-family: 'Enriqueta', serif;
            font-weight: 600;
            color: #071D49;
            margin-bottom: 6px;
            font-size: 14px;
        }
        .form-group input {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid #ddd;
            border-radius: 8px;
            font-family: 'Urbanist', sans-serif;
            font-size: 15px;
            transition: border-color 0.2s;
            box-sizing: border-box;
        }
        .form-group input:focus { outline: none; border-color: #2BD5C3; }
        .hint {
            font-family: 'Urbanist', sans-serif;
            font-size: 12px;
            color: #aaa;
            margin-top: 4px;
        }
        .auth-btn {
            width: 100%;
            padding: 13px;
            background: #071D49;
            color: white;
            border: none;
            border-radius: 8px;
            font-family: 'Enriqueta', serif;
            font-size: 16px;
            cursor: pointer;
            transition: background 0.2s;
            margin-top: 8px;
        }
        .auth-btn:hover { background: #2BD5C3; color: #071D49; }
        .auth-footer {
            text-align: center;
            margin-top: 24px;
            font-family: 'Urbanist', sans-serif;
            font-size: 14px;
            color: #666;
        }
        .auth-footer a { color: #071D49; font-weight: 600; text-decoration: none; }
        .auth-footer a:hover { color: #2BD5C3; }
        .back-home {
            display: inline-block;
            margin-top: 16px;
            font-family: 'Urbanist', sans-serif;
            font-size: 13px;
            color: #999;
            text-decoration: none;
        }
        .back-home:hover { color: #071D49; }
    </style>
</head>
<body>
    <header class="navbar">
        <div class="logo-box">
            <img src="/images/logo.png" alt="Cinnabon Logo" class="logo">
        </div>
        <nav class="nav-links">
            <a href="/">Home</a>
            <a href="/products">Menu</a>
            <a href="/auth/login">Login</a>
        </nav>
    </header>

    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-logo">
                <img src="/images/logo.png" alt="Cinnabon">
            </div>
            <h1 class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Join the Cinnabon family today</p>

            <% if (error && error.length > 0) { %>
                <div class="flash-msg flash-error"><%= error[0] %></div>
            <% } %>
            <% if (success && success.length > 0) { %>
                <div class="flash-msg flash-success"><%= success[0] %></div>
            <% } %>

            <form action="/auth/register" method="POST">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Your full name"
                        value="<%= formData.name || '' %>"
                        required
                        autocomplete="name"
                    >
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="you@example.com"
                        value="<%= formData.email || '' %>"
                        required
                        autocomplete="email"
                    >
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="••••••••"
                        required
                        autocomplete="new-password"
                    >
                    <p class="hint">Minimum 6 characters</p>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        placeholder="••••••••"
                        required
                        autocomplete="new-password"
                    >
                </div>
                <button type="submit" class="auth-btn">Create Account</button>
            </form>

            <div class="auth-footer">
                Already have an account? <a href="/auth/login">Sign in</a>
            </div>
            <div style="text-align:center;">
                <a href="/" class="back-home">← Back to Home</a>
            </div>
        </div>
    </div>
</body>
</html>
