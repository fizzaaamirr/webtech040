<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Cinnabon PK</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Enriqueta:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Enriqueta:wght@400;500;600;700&family=Urbanist:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-layout { display: flex; min-height: 100vh; margin-top: 80px; }
        .admin-sidebar { width: 240px; background: #071D49; color: white; padding: 20px; font-family: 'Enriqueta', serif; }
        .admin-sidebar a { display: block; color: white; padding: 10px; text-decoration: none; margin-bottom: 10px; border-radius: 5px; }
        .admin-sidebar a:hover, .admin-sidebar a.active { background: #2BD5C3; color: #071D49; font-weight: bold; }
        .admin-sidebar .sidebar-divider { border: none; border-top: 1px solid rgba(255,255,255,0.15); margin: 12px 0; }
        .admin-sidebar .sidebar-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: rgba(255,255,255,0.4); padding: 0 10px; margin-bottom: 6px; }
        .admin-content { flex: 1; padding: 30px; background: #f8f8f8; font-family: 'Enriqueta', serif; }
        .admin-table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; font-family: 'Urbanist', sans-serif;}
        .admin-table th, .admin-table td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #eee; }
        .admin-table th { background: #071D49; color: white; }
        .btn { padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; font-size: 13px; display: inline-block; font-family: 'Urbanist', sans-serif; }
        .btn-edit   { background: #f39c12; color: white; }
        .btn-delete { background: #e74c3c; color: white; }
        .btn-add    { background: #27ae60; color: white; margin-bottom: 20px; font-family: 'Enriqueta', serif; }

        /* ── Sales preview card ── */
        .sales-preview-card {
            background: linear-gradient(135deg, #071D49, #0d3080);
            border-radius: 12px;
            padding: 20px 24px;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-family: 'Urbanist', sans-serif;
            box-shadow: 0 4px 16px rgba(7,29,73,0.15);
        }
        .sales-preview-card .sp-left h3 {
            color: #2BD5C3;
            font-family: 'Enriqueta', serif;
            margin: 0 0 4px 0;
            font-size: 16px;
        }
        .sales-preview-card .sp-left p {
            color: rgba(255,255,255,0.6);
            margin: 0;
            font-size: 13px;
        }
        .sales-preview-card .sp-stats {
            display: flex;
            gap: 32px;
        }
        .sales-preview-card .sp-stat {
            text-align: center;
        }
        .sales-preview-card .sp-stat .val {
            font-size: 26px;
            font-weight: 700;
            color: white;
            line-height: 1;
        }
        .sales-preview-card .sp-stat .lbl {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-top: 4px;
        }
        .btn-sales {
            background: #2BD5C3;
            color: #071D49;
            font-weight: 700;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-family: 'Enriqueta', serif;
            font-size: 14px;
            white-space: nowrap;
        }
        .btn-sales:hover { background: white; }
    </style>
</head>
<body>
    <header class="navbar">
        <div class="logo-box"><img src="/images/logo.png" alt="Logo" class="logo"></div>
        <nav class="nav-links">
            <a href="/">Home</a>
            <a href="/products">Products</a>
            <a href="/admin" class="active">Admin</a>
            <a href="/sales">Sales</a>
            <% if (currentUser.isLoggedIn) { %>
                <span style="font-family:'Urbanist',sans-serif;font-size:14px;color:#071D49;">Hi, <%= currentUser.name.split(' ')[0] %></span>
                <form action="/auth/logout" method="POST" style="display:inline;">
                    <button type="submit" style="background:none;border:none;cursor:pointer;font-family:'Urbanist',sans-serif;font-size:14px;color:#071D49;padding:0;">Logout</button>
                </form>
            <% } %>
        </nav>
    </header>

    <div class="admin-layout">
        <!-- ── Sidebar ── -->
        <div class="admin-sidebar">
            <h3>Admin Panel</h3>

            <div class="sidebar-label">Products</div>
            <a href="/admin" class="active">Dashboard</a>
            <a href="/admin/add">Add Product</a>

            <hr class="sidebar-divider">

            <div class="sidebar-label">Reports</div>
            <a href="/sales">Sales Dashboard</a>

            <hr class="sidebar-divider">

            <a href="/">View Store</a>
        </div>

        <!-- ── Main content ── -->
        <div class="admin-content">
            <% if (flashSuccess && flashSuccess.length > 0) { %>
                <div style="background:#eafaf1;color:#1e8449;border-left:4px solid #2ecc71;padding:12px 16px;border-radius:8px;margin-bottom:20px;font-family:'Urbanist',sans-serif;font-size:14px;">✓ <%= flashSuccess[0] %></div>
            <% } %>
            <% if (flashError && flashError.length > 0) { %>
                <div style="background:#fdecea;color:#c0392b;border-left:4px solid #e74c3c;padding:12px 16px;border-radius:8px;margin-bottom:20px;font-family:'Urbanist',sans-serif;font-size:14px;">✕ <%= flashError[0] %></div>
            <% } %>

            <!-- ── Sales preview banner ── -->
            <div class="sales-preview-card">
                <div class="sp-left">
                    <h3>Sales Dashboard</h3>
                    <p>Live revenue &amp; order tracking</p>
                </div>
                <div class="sp-stats">
                    <div class="sp-stat">
                        <div class="val" id="preview-revenue">—</div>
                        <div class="lbl">Revenue</div>
                    </div>
                    <div class="sp-stat">
                        <div class="val" id="preview-orders">—</div>
                        <div class="lbl">Orders</div>
                    </div>
                </div>
                <a href="/sales" class="btn-sales">View Full Dashboard →</a>
            </div>

            <!-- ── Product table ── -->
            <h2>Product Inventory</h2>
            <a href="/admin/add" class="btn btn-add">+ Add New Product</a>
            <table class="admin-table">
                <thead>
                    <tr><th>Image</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    <% products.forEach(p => { %>
                    <tr>
                        <td><img src="<%= p.image %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;"></td>
                        <td><%= p.name %></td>
                        <td><%= p.category %></td>
                        <td>$<%= p.price %></td>
                        <td><%= p.stock %></td>
                        <td>
                            <a href="/admin/edit/<%= p._id %>" class="btn btn-edit">Edit</a>
                            <form action="/admin/delete/<%= p._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <button type="submit" class="btn btn-delete">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <script src="/js/script.js"></script>
    <!-- Load quick sales preview stats via fetch -->
    <script>
        fetch('/api/sales-data')
            .then(res => res.json())
            .then(data => {
                document.getElementById('preview-revenue').textContent = '$' + parseFloat(data.totalRevenue).toFixed(2);
                document.getElementById('preview-orders').textContent  = data.totalOrders;
            })
            .catch(() => {
                document.getElementById('preview-revenue').textContent = 'N/A';
                document.getElementById('preview-orders').textContent  = 'N/A';
            });
    </script>
</body>
</html>
